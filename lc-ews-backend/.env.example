# Copy this file to .env and fill in your values
# .env is gitignored — never commit the real .env

# JWT secret — use a long random string in production
JWT_SECRET_KEY=your_secret_key_here

# Database connection string
# SQLite (local dev):
DATABASE_URL=sqlite:///./lc_ews.db

# Azure SQL (production):
# DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Azure PostgreSQL (production):
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com/<db>?sslmode=require
